[Unit]
Description=Deliver durable Weixin outbox alerts through GitHub chat control plane
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.hermes/reliable-weixin-ops.env
ExecStart=/bin/bash %h/.hermes/scripts/outbox-ops.sh alert-drain
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
